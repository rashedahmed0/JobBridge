@model List<RecruiterJobRow>
@{
    ViewData["Title"] = "My Jobs";
    ViewData["Tab"] = "jobs";
}
<partial name="_RecruiterTabs" />

@if (Model.Count == 0)
{
    <div class="card">No jobs yet. Use Post a Job to publish your first listing.</div>
}
@foreach (var r in Model)
{
    var j = r.Job;
    <div class="card">
        <div class="row sp">
            <div>
                <h3>@j.Title <span class="tag">@(j.IsOpen ? "open" : "closed")</span></h3>
                <span class="mut">@j.Location · @j.Type · @r.ApplicantCount applicants</span>
            </div>
            <div class="row">
                <a class="btn sm" asp-action="Applicants" asp-route-id="@j.Id">Applicants</a>
                <a class="btn alt sm" asp-action="Post" asp-route-id="@j.Id">Edit</a>
                <form asp-action="Toggle" asp-route-id="@j.Id" method="post" class="inl">
                    <button class="btn alt sm" type="submit">@(j.IsOpen ? "Close" : "Reopen")</button>
                </form>
                <form asp-action="Delete" asp-route-id="@j.Id" method="post" class="inl"
                      data-confirm="Delete this job and its applications?">
                    <button class="btn bad sm" type="submit">Delete</button>
                </form>
            </div>
        </div>
    </div>
}
