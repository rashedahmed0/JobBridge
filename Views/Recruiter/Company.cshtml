@model CompanyVm
@{
    ViewData["Title"] = "Company Profile";
    ViewData["Tab"] = "prof";
}
<partial name="_RecruiterTabs" />

<div class="card" style="max-width:520px">
    <form asp-action="Company" method="post">
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="Company"></label>
        <input asp-for="Company" />
        <span asp-validation-for="Company" class="err"></span>

        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="err"></span>

        <label asp-for="Website"></label>
        <input asp-for="Website" />

        <label asp-for="Location"></label>
        <input asp-for="Location" />

        <label asp-for="About"></label>
        <textarea asp-for="About"></textarea>

        <br />
        <button class="btn" type="submit">Save profile</button>
    </form>
</div>
