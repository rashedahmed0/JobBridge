@model List<JobApplication>
@{
    ViewData["Title"] = "My Applications";
    ViewData["Tab"] = "apps";
}
<partial name="_SeekerTabs" />

@if (Model.Count == 0)
{
    <div class="card">No applications yet. Find a job in the feed and press Apply Now.</div>
}
else
{
    <div class="card gw">
        <table>
            <thead><tr><th>Job</th><th>Company</th><th>Applied</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@a.JobId">@a.Job.Title</a></td>
                    <td>@a.Job.Company</td>
                    <td>@a.AppliedDate.ToString("yyyy-MM-dd")</td>
                    <td><span class="tag">@a.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
