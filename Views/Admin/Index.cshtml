
@model AdminOverviewVm

@{
    ViewData["Title"] = "Admin";
    ViewData["Tab"] = "ov";
}

<partial name="_AdminTabs" />

<style>
    .dashboard {
        padding: 24px;
        background: #f8fafc;
        min-height: 100vh;
        color: #0f172a;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 26px;
        flex-wrap: wrap;
    }

        .dashboard-header h2 {
            font-size: 26px;
            font-weight: 750;
            margin: 0 0 7px;
        }

        .dashboard-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    .dashboard-badge {
        background: #e0f2fe;
        color: #0369a1;
        padding: 9px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .035);
        min-width: 0;
        transition: transform .2s, box-shadow .2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, .07);
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .stat-label {
        font-size: 14px;
        color: #64748b;
        font-weight: 500;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 13px;
        font-size: 22px;
        flex-shrink: 0;
    }

    .icon-blue {
        background: #eff6ff;
        color: #2563eb;
    }

    .icon-green {
        background: #ecfdf5;
        color: #059669;
    }

    .icon-orange {
        background: #fff7ed;
        color: #ea580c;
    }

    .icon-purple {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 750;
        letter-spacing: -.8px;
        line-height: 1.2;
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    .stat-description {
        color: #94a3b8;
        font-size: 12px;
        margin-bottom: 17px;
    }

    .mini-chart {
        height: 48px;
        width: 100%;
        position: relative;
    }

        .mini-chart canvas {
            width: 100% !important;
            height: 48px !important;
        }

    .charts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr);
        gap: 22px;
        margin-bottom: 24px;
    }

    .chart-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .035);
        min-width: 0;
    }

    .chart-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .chart-heading h3 {
            margin: 0 0 7px;
            font-size: 17px;
            font-weight: 700;
        }

        .chart-heading p {
            color: #94a3b8;
            font-size: 13px;
            margin: 0;
        }

    .chart-tag {
        background: #f1f5f9;
        color: #475569;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 12px;
    }

    .main-chart-container {
        height: 300px;
        position: relative;
    }

    .status-chart-container {
        height: 260px;
        max-width: 330px;
        margin: 0 auto;
        position: relative;
    }

    .status-legend {
        display: grid;
        gap: 14px;
        margin-top: 20px;
    }

    .legend-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        font-size: 13px;
    }

    .legend-label {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #64748b;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .legend-value {
        font-weight: 700;
        color: #0f172a;
    }

    .dashboard-footer {
        text-align: center;
        padding: 14px 0 4px;
        color: #94a3b8;
        font-size: 12px;
    }

    @@media (max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .dashboard {
            padding: 14px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .stat-card {
            padding: 18px;
        }

        .chart-card {
            padding: 17px;
        }

        .stat-number {
            font-size: 28px;
        }

        .dashboard-header h2 {
            font-size: 22px;
        }

        .main-chart-container {
            height: 250px;
        }
    }
</style>

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h2>Admin Dashboard</h2>
            <p>Overview of your JobBridge platform.</p>
        </div>

        <div class="dashboard-badge">
            ● Platform Overview
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Job Seekers</div>
                <div class="stat-icon icon-blue">♙</div>
            </div>

            <div class="stat-number">
                @Model.Seekers.ToString("N0")
            </div>

            <div class="stat-description">
                Total registered job seekers
            </div>

            <div class="mini-chart">
                <canvas id="seekersMiniChart"></canvas>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Recruiters</div>
                <div class="stat-icon icon-green">▦</div>
            </div>

            <div class="stat-number">
                @Model.Recruiters.ToString("N0")
            </div>

            <div class="stat-description">
                Total registered recruiters
            </div>

            <div class="mini-chart">
                <canvas id="recruitersMiniChart"></canvas>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Total Jobs</div>
                <div class="stat-icon icon-orange">▣</div>
            </div>

            <div class="stat-number">
                @Model.Jobs.ToString("N0")
            </div>

            <div class="stat-description">
                Total jobs in the platform
            </div>

            <div class="mini-chart">
                <canvas id="jobsMiniChart"></canvas>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Applications</div>
                <div class="stat-icon icon-purple">▤</div>
            </div>

            <div class="stat-number">
                @Model.Applications.ToString("N0")
            </div>

            <div class="stat-description">
                Total submitted applications
            </div>

            <div class="mini-chart">
                <canvas id="applicationsMiniChart"></canvas>
            </div>
        </div>

    </div>

    <!-- Charts -->
    @* <div class="charts-grid">

        <div class="chart-card">
            <div class="chart-heading">
                <div>
                    <h3>Platform Statistics</h3>
                    <p>Monthly activity overview</p>
                </div>

                <span class="chart-tag">Sample Data</span>
            </div>

            <div class="main-chart-container">
                <canvas id="platformChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-heading">
                <div>
                    <h3>Application Overview</h3>
                    <p>Application status distribution</p>
                </div>
            </div>

            <div class="status-chart-container">
                <canvas id="applicationStatusChart"></canvas>
            </div>

            <div class="status-legend">
                <div class="legend-item">
                    <div class="legend-label">
                        <span class="legend-dot"
                              style="background:#f59e0b"></span>
                        Pending
                    </div>
                    <span class="legend-value" id="pendingValue">—</span>
                </div>

                <div class="legend-item">
                    <div class="legend-label">
                        <span class="legend-dot"
                              style="background:#10b981"></span>
                        Accepted
                    </div>
                    <span class="legend-value" id="acceptedValue">—</span>
                </div>

                <div class="legend-item">
                    <div class="legend-label">
                        <span class="legend-dot"
                              style="background:#ef4444"></span>
                        Rejected
                    </div>
                    <span class="legend-value" id="rejectedValue">—</span>
                </div>
            </div>
        </div>

    </div>

    <div class="dashboard-footer">
        JobBridge Admin Panel
    </div> *@

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Actual counts from the Razor model.
        const totals = {
            seekers: @Model.Seekers,
            recruiters: @Model.Recruiters,
            jobs: @Model.Jobs,
            applications: @Model.Applications
            };

        // Mini charts: illustrative trends, not historical database data.
        function createMiniChart(id, values, color) {
            const canvas = document.getElementById(id);
            if (!canvas) return;

            new Chart(canvas, {
                type: "line",
                data: {
                    labels: ["1", "2", "3", "4", "5", "6", "7"],
                    datasets: [{
                        data: values,
                        borderColor: color,
                        borderWidth: 2,
                        fill: false,
                        tension: 0.45,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false }
                    },
                    elements: {
                        line: { capBezierPoints: true }
                    }
                }
            });
        }

        createMiniChart(
            "seekersMiniChart",
            [12, 18, 15, 27, 23, 34, 40],
            "#2563eb"
        );

        createMiniChart(
            "recruitersMiniChart",
            [8, 12, 10, 19, 16, 24, 29],
            "#059669"
        );

        createMiniChart(
            "jobsMiniChart",
            [10, 8, 17, 14, 24, 21, 32],
            "#ea580c"
        );

        createMiniChart(
            "applicationsMiniChart",
            [14, 20, 17, 28, 25, 35, 43],
            "#7c3aed"
        );

        // Monthly chart: replace these examples with backend data.
        const monthlyLabels = [
            "May", "Jun", "Jul", "Aug", "Sep", "Oct"
        ];

        const monthlySeekers = [80, 110, 95, 145, 130, 175];
        const monthlyJobs = [22, 30, 25, 38, 32, 48];

        new Chart(document.getElementById("platformChart"), {
            type: "bar",
            data: {
                labels: monthlyLabels,
                datasets: [
                    {
                        label: "Job Seekers",
                        data: monthlySeekers,
                        backgroundColor: "#3b82f6",
                        borderRadius: 5,
                        maxBarThickness: 24
                    },
                    {
                        label: "Jobs",
                        data: monthlyJobs,
                        backgroundColor: "#10b981",
                        borderRadius: 5,
                        maxBarThickness: 24
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: "index",
                    intersect: false
                },
                plugins: {
                    legend: {
                        position: "bottom",
                        labels: {
                            usePointStyle: true,
                            padding: 20
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        border: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        border: { display: false },
                        grid: { color: "#f1f5f9" },
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        // Placeholder status distribution.
        // Replace with actual Pending / Accepted / Rejected counts.
        const applicationStatuses = {
            pending: 45,
            accepted: 35,
            rejected: 20
        };

        document.getElementById("pendingValue").textContent =
            applicationStatuses.pending;

        document.getElementById("acceptedValue").textContent =
            applicationStatuses.accepted;

        document.getElementById("rejectedValue").textContent =
            applicationStatuses.rejected;

        new Chart(document.getElementById("applicationStatusChart"), {
            type: "doughnut",
            data: {
                labels: ["Pending", "Accepted", "Rejected"],
                datasets: [{
                    data: [
                        applicationStatuses.pending,
                        applicationStatuses.accepted,
                        applicationStatuses.rejected
                    ],
                    backgroundColor: [
                        "#f59e0b",
                        "#10b981",
                        "#ef4444"
                    ],
                    borderWidth: 0,
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "72%",
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

    });
</script>
