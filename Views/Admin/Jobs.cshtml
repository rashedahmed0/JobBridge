@model List<Job>
@{
    ViewData["Title"] = "Jobs";
    ViewData["Tab"] = "jobs";
}
<partial name="_AdminTabs" />

<div class="card gw">
    <table class="gt" id="gj">
        <thead>
            <tr>
                <th data-sort="0">Title<span class="ind"></span></th>
                <th data-sort="1">Company<span class="ind"></span></th>
                <th data-sort="2">Location<span class="ind"></span></th>
                <th data-sort="3">Status<span class="ind"></span></th>
                <th>Action</th>
            </tr>
            <tr class="fr">
                <th><input data-col="0" placeholder="Filter…" /></th>
                <th><input data-col="1" placeholder="Filter…" /></th>
                <th>
                    <select data-col="2">
                        <option value="">All</option>
                        @foreach (var l in Model.Select(j => j.Location).Distinct())
                        {
                            <option>@l</option>
                        }
                    </select>
                </th>
                <th>
                    <select data-col="3">
                        <option value="">All</option>
                        <option>open</option>
                        <option>closed</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var j in Model)
        {
            <tr>
                <td>@j.Title</td>
                <td>@j.Company</td>
                <td>@j.Location</td>
                <td>@(j.IsOpen ? "open" : "closed")</td>
                <td>
                    <form asp-action="ToggleJob" asp-route-id="@j.Id" method="post" class="inl">
                        <button class="btn alt sm" type="submit">@(j.IsOpen ? "Close" : "Reopen")</button>
                    </form>
                    <form asp-action="DeleteJob" asp-route-id="@j.Id" method="post" class="inl"
                          data-confirm="Delete this job and its applications?">
                        <button class="btn bad sm" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="row sp mut" style="padding:8px 12px">
        <span data-count-for="gj"></span>
        <button class="btn alt sm" type="button" data-clear-for="gj">Clear filters</button>
    </div>
</div>
